screen:
  name: "EventDetails"
  position: "center,center"
  size: "1800,930"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        alphatest: "on"
        name: "picon"
        position: "20,70"
        scale: "1"
        scaleFlags: "scaleCenter"
        size: "100,100"
    - widget:
        font: "$FR_big"
        name: "title"
        position: "150,70"
        size: "1100,43"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$FR_medium"
        name: "subtitle"
        position: "150,125"
        size: "1100,37"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$FR_medium"
        name: "duration"
        position: "150,170"
        size: "300,37"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$FR_medium"
        name: "description"
        position: "20,230"
        size: "1230,560"
        transparent: "1"
    - widget:
        name: "programpix"
        position: "1270,70"
        scaleFlags: "scaleCenter"
        size: "500,375"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
