screen:
  backgroundColor: "panelBG"
  flags: "wfNoBorder"
  name: "ProgramColumns"
  position: "center,center"
  resolution: "1920,1080"
  size: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        font: "$FR_verysmall"
        halign: "right"
        name: "day_selector"
        position: "1490,15"
        size: "420,26"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "0"
        position: "0*$screen_width/6,0"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "1"
        position: "1*$screen_width/6,0"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "2"
        position: "2*$screen_width/6,0"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "3"
        position: "3*$screen_width/6,0"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "4"
        position: "4*$screen_width/6,0"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "5"
        position: "5*$screen_width/6,0"
    - widget:
        backgroundColorSelected: "keyBlue"
        enableWrapAround: "1"
        position: "0,275"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "320,750"
        source: "list0"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - widget:
        backgroundColorSelected: "keyBlue"
        enableWrapAround: "1"
        position: "320,275"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "320,750"
        source: "list1"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - widget:
        backgroundColorSelected: "keyBlue"
        enableWrapAround: "1"
        position: "640,275"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "320,750"
        source: "list2"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - widget:
        backgroundColorSelected: "keyBlue"
        enableWrapAround: "1"
        position: "960,275"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "320,750"
        source: "list3"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - widget:
        backgroundColorSelected: "keyBlue"
        enableWrapAround: "1"
        position: "1280,275"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "320,750"
        source: "list4"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - widget:
        backgroundColorSelected: "keyBlue"
        enableWrapAround: "1"
        position: "1600,275"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "320,750"
        source: "list5"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - xmlinc:
        file: "screenpart_BottomBar.ymlinc"
    - xmlinc:
        file: "screenpart_ButtonBar.ymlinc"
        position: "0,$screen_height-48"
