convert:
  type: "TemplatedMultiContent"
  cell:
    itemHeight: 150
    width: 320
    selectionEnabled: false
    border:
      width: 1
      color: 0x595959
      font: "Regular;20"
      flags: RT_VALIGN_CENTER
    fonts:
      - "Regular;23"
      - "Regular;20"
      - "Regular;17"
    fields:
      - text:
          rect: [5, 5, 55, 25]
          font: "Regular;20"
          flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
          value: 0
      - text:
          rect: [5, 32, 55, 20]
          font: "Regular;17"
          flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
          value: 9
      - text:
          rect: [65, 5, 245, 75]
          font: "Regular;23"
          flags: RT_HALIGN_LEFT|RT_WRAP
          value: 1
      - text:
          rect: [65, 90, 245, 25]
          font: "Regular;20"
          flags: RT_HALIGN_LEFT|RT_WRAP
          value: 2
          color: 0xa0a0a0
          color_sel: 0xa0a0a0
      - text:
          rect: [65, 118, 245, 25]
          font: "Regular;20"
          flags: RT_HALIGN_LEFT|RT_WRAP
          value: 3
          color: 0xa0a0a0
          color_sel: 0xa0a0a0
