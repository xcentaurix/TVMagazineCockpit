          font: "Regular;17"
          flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
          value: 9
      - text:
          position: "65,5"
          size: "245,75"
          font: "Regular;23"
          flags: RT_HALIGN_LEFT|RT_WRAP
          value: 1
      - text:
